# URL HTTPS visibile dagli utenti e da ElevenLabs, senza slash finale.
APP_URL=https://demo.example.it

# Porta pubblicata sul server. Con un reverse proxy locale usa, ad esempio, 8080.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080

# In produzione HTTPS deve essere true.
COOKIE_SECURE=true
ELEVENLABS_VERIFY_SSL=true

# Usata solo quando il database non contiene ancora utenti.
INITIAL_ADMIN_PASSWORD=sostituisci-con-una-password-lunga

# Opzionale: necessario solo con `docker compose --profile tunnel up -d`.
CLOUDFLARE_TUNNEL_TOKEN=

# Opzionale: puoi fissare una versione specifica dell'immagine cloudflared.
CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest

# Opzionale: signing secret del webhook post-call ElevenLabs al primo avvio.
# In alternativa configurarlo dall'interfaccia dopo il deploy.
POST_CALL_WEBHOOK_SECRET=
