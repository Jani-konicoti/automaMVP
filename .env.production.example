# URL HTTPS visibile dagli utenti e da ElevenLabs, senza slash finale.
APP_URL=https://demo.example.it

# Porta pubblicata sul server. Con un reverse proxy locale usa, ad esempio, 8080.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080

# In produzione HTTPS deve essere true.
COOKIE_SECURE=true
COOKIE_SAMESITE=none
ELEVENLABS_VERIFY_SSL=true

# Token Bearer per POST /api/create-vector-store. Usare un valore lungo e casuale.
VECTOR_STORE_API_TOKEN=sostituisci-con-un-token-lungo-e-casuale

# Connettore WikiWeb Centro Paghe. Usare preferibilmente una Bot Password MediaWiki.
MEDIAWIKI_BASE_URL=https://wikiweb.centropaghe.it
MEDIAWIKI_ROOT_PAGE=Help_On_Line
MEDIAWIKI_USERNAME=
MEDIAWIKI_PASSWORD=
MEDIAWIKI_TENANT=principale
MEDIAWIKI_AREA=Paghe Web
MEDIAWIKI_SYNC_INTERVAL_MINUTES=15
MEDIAWIKI_FULL_SYNC_HOURS=24
MEDIAWIKI_VERIFY_SSL=true

# Origini autorizzate a incorporare /presentazione-cpeople in un iframe.
# Separare piu origini con uno spazio, senza slash finale.
IFRAME_ANCESTORS='self' https://plugin.example.it

# Usata solo quando il database non contiene ancora utenti.
INITIAL_ADMIN_PASSWORD=sostituisci-con-una-password-lunga

# Opzionale: necessario solo con `docker compose --profile tunnel up -d`.
CLOUDFLARE_TUNNEL_TOKEN=

# Opzionale: puoi fissare una versione specifica dell'immagine cloudflared.
CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest

# Opzionale: signing secret del webhook post-call ElevenLabs al primo avvio.
# In alternativa configurarlo dall'interfaccia dopo il deploy.
POST_CALL_WEBHOOK_SECRET=
